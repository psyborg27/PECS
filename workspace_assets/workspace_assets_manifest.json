  "merge_strategies": {
    "overwrite": "Completely replace target file with source",
    "create_if_missing": "Only create if target doesn't exist",
    "append": "Append source content to target (text files)",
    "append_or_merge": "Append for text, merge for structured files",
    "merge_yaml": "Deep merge YAML structures",
    "merge_json": "Deep merge JSON objects",
    "merge_vscode_tasks": "Merge VS Code tasks and inputs while preserving existing definitions",
    "merge_markdown": "Safe merge markdown sections",
    "preserve_existing": "Never modify target, always keep existing"
  },
  "installation_flow": {
    "phase_1_validation": [
      "Verify target workspace exists",
      "Verify PECS repository root available",
      "Verify workspace not PECS repository itself"
    ],
    "phase_2_backup": [
